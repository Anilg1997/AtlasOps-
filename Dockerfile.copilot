FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY . .
RUN mvn -q package -pl backend/ai-copilot-service -am -DskipTests

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=build /build/backend/ai-copilot-service/target/*.jar /app/ai-copilot-service.jar
EXPOSE 8083
ENTRYPOINT ["java", "-jar", "/app/ai-copilot-service.jar"]
