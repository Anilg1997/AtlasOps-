FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY . .
RUN mvn -q package -pl backend/billing-service -am -DskipTests

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=build /build/backend/billing-service/target/*.jar /app/billing-service.jar
EXPOSE 8084
ENTRYPOINT ["java", "-jar", "/app/billing-service.jar"]
